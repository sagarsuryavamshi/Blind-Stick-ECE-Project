# Backend API Server Endpoint (Render URL in production)
# Example: https://smartguard-backend.onrender.com
VITE_API_URL=https://your-backend-app.onrender.com

# Socket.IO Real-Time Stream URL (Optional: Defaults to VITE_API_URL if omitted)
# Example: https://smartguard-backend.onrender.com
VITE_SOCKET_URL=https://your-backend-app.onrender.com

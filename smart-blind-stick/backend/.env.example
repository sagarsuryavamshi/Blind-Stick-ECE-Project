# Server Configuration
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database Configuration (Leave empty or set your MongoDB Atlas URI)
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/smartguard?retryWrites=true&w=majority
MONGODB_URI=

# Device Security
DEVICE_AUTH_TOKEN=smartguard_esp32_secret_token_2026
DEVICE_ID=BLINDSTICK001

# Caregiver JWT Auth Secret
JWT_SECRET=smartguard_production_jwt_secret_change_me_in_render_2026

# Rate Limiting
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300

# ========================================================
# HARDWARE EMERGENCY NOTIFICATION ARCHITECTURE
# ========================================================
# Emergency SMS and Voice calls are handled directly by the on-device
# physical SIM900A GSM module connected to the ESP32 via UART.
# No cloud communication APIs or Twilio credentials are used.
